{
  "name": "CatVert",
  "syncRules": [
	{
		"pattern": "*.json",
		"use": "text"
	}
  ],
  "tree": {
	"$className": "DataModel",
	"ReplicatedStorage": {
		"$className": "ReplicatedStorage",
		"CatVert": {
			"$path": "lib"
		},
		"Resources": {
			"$path": "resources/json"
		},
		"Tests": {
			"$path": "tests"
		},
		"Lest": {
			"$path": ".lest/core"
		}
	}
  }
}
